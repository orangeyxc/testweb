<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>支付設定</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="container">
        <h1 class="logo">資源商店 🛒</h1>
        <ul class="nav-menu">
          <li><a href="/">首頁</a></li>
          <li><a href="/cart">購物車</a></li>
          <li><a href="/orders">訂單記錄</a></li>
          <li><a href="/payment" class="active">支付設定</a></li>
          <li><a href="/logout">登出 (<%= user.username %>)</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <main class="container">
    <h2>支付方式管理</h2>
    
    <div class="payment-container">
      <div class="payment-methods">
        <h3>已保存嘅支付方式</h3>
        <% if (paymentMethods.length === 0) { %>
          <p>未有保存嘅支付方式</p>
        <% } else { %>
          <div class="payment-list">
            <% paymentMethods.forEach(method => { %>
              <div class="payment-item">
                <div class="payment-icon">💳</div>
                <div class="payment-details">
                  <p><strong><%= method.card_holder %></strong></p>
                  <p><%= method.card_number %></p>
                  <p>到期日: <%= method.expiry_date %></p>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
      
      <div class="add-payment">
        <h3>添加新支付方式</h3>
        <form id="paymentForm">
          <div class="form-group">
            <label for="card_holder">持卡人姓名</label>
            <input type="text" id="card_holder" name="card_holder" required>
          </div>
          <div class="form-group">
            <label for="card_number">信用卡號</label>
            <input type="text" id="card_number" name="card_number" 
                   placeholder="1234-5678-9012-3456" 
                   pattern="[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}" 
                   required>
            <small>格式: XXXX-XXXX-XXXX-XXXX</small>
          </div>
          <div class="form-group">
            <label for="expiry_date">到期日</label>
            <input type="text" id="expiry_date" name="expiry_date" 
                   placeholder="MM/YY" 
                   pattern="[0-9]{2}/[0-9]{2}" 
                   required>
            <small>格式: MM/YY</small>
          </div>
          <button type="submit" class="btn btn-primary">添加支付方式</button>
        </form>
      </div>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 資源商店. 版權所有.</p>
    </div>
  </footer>

  <script>
    document.getElementById('paymentForm').addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = {
        card_holder: document.getElementById('card_holder').value,
        card_number: document.getElementById('card_number').value,
        expiry_date: document.getElementById('expiry_date').value
      };

      fetch('/payment/add', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
      })
      .then(res => res.json())
      .then(data => {
        if (data.success) {
          alert(data.message);
          location.reload();
        } else {
          alert(data.error || '添加失敗');
        }
      })
      .catch(err => {
        console.error(err);
        alert('操作失敗');
      });
    });
  </script>
</body>
</html>
