<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>股票預測中心 - 滬深港股分析</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/stocks.css">
</head>
<body>
  <header>
    <nav class="navbar stock-navbar">
      <div class="container">
        <a href="/stocks" class="logo stock-logo">📊 股票預測中心</a>
        <ul class="nav-menu">
          <li><a href="/stocks" class="<%= !market || market==='all' ? 'active' : '' %>">全部股票</a></li>
          <li><a href="/stocks?market=SHSE" class="<%= market==='SHSE' ? 'active' : '' %>">上海A股</a></li>
          <li><a href="/stocks?market=SZSE" class="<%= market==='SZSE' ? 'active' : '' %>">深圳A股</a></li>
          <li><a href="/stocks?market=HKEX" class="<%= market==='HKEX' ? 'active' : '' %>">香港股市</a></li>
          <li><a href="/">🛒 商店</a></li>
          <% if (user) { %>
            <li><a href="/logout">登出 (<%= user.username %>)</a></li>
          <% } else { %>
            <li><a href="/login">登入</a></li>
          <% } %>
        </ul>
      </div>
    </nav>
  </header>

  <main class="container">
    <!-- 頁面標題 (Page header) -->
    <section class="stock-hero">
      <div class="stock-hero-content">
        <h1>📊 股票預測分析中心</h1>
        <p>結合技術分析、行業趨勢、全球事件及市場情緒，為您提供智能投資決策建議</p>
        <div class="hero-badges">
          <span class="badge badge-cn">🇨🇳 滬深A股</span>
          <span class="badge badge-hk">🇭🇰 香港股市</span>
          <span class="badge badge-ai">🤖 AI智能分析</span>
        </div>
      </div>
    </section>

    <!-- 搜索欄 (Search bar) -->
    <div class="search-section">
      <form action="/stocks" method="GET" class="search-form">
        <input type="hidden" name="market" value="<%= market %>">
        <div class="search-input-group">
          <span class="search-icon">🔍</span>
          <input type="text" name="search" placeholder="搜索股票名稱或代碼..." value="<%= search %>" class="search-input">
          <button type="submit" class="btn btn-primary">搜索</button>
        </div>
      </form>
    </div>

    <!-- 全球事件快訊 (Global events ticker) -->
    <div class="events-ticker">
      <span class="ticker-label">📰 市場快訊：</span>
      <div class="ticker-content">
        <% globalEvents.forEach(evt => { %>
          <span class="ticker-item <%= evt.impact > 0 ? 'positive' : 'negative' %>">
            <%= evt.impact > 0 ? '▲' : '▼' %> <%= evt.event %>
          </span>
        <% }); %>
      </div>
    </div>

    <!-- 市場篩選標籤 (Market filter tabs) -->
    <div class="market-tabs">
      <a href="/stocks<%= search ? '?search='+search : '' %>" class="tab <%= !market || market==='all' ? 'active' : '' %>">全部</a>
      <a href="/stocks?market=SHSE<%= search ? '&search='+search : '' %>" class="tab <%= market==='SHSE' ? 'active' : '' %>">🇨🇳 上海A股</a>
      <a href="/stocks?market=SZSE<%= search ? '&search='+search : '' %>" class="tab <%= market==='SZSE' ? 'active' : '' %>">🇨🇳 深圳A股</a>
      <a href="/stocks?market=HKEX<%= search ? '&search='+search : '' %>" class="tab <%= market==='HKEX' ? 'active' : '' %>">🇭🇰 港股</a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <!-- 股票列表 (Stock list) -->
    <div class="stocks-grid">
      <%
        let displayStocks = stocks;
        if (market && market !== 'all') {
          displayStocks = stocks.filter(s => s.market === market);
        }
        if (search) {
          const q = search.toLowerCase();
          displayStocks = displayStocks.filter(s =>
            s.name.toLowerCase().includes(q) || s.symbol.includes(q)
          );
        }
      %>

      <% if (displayStocks.length === 0) { %>
        <div class="no-results">
          <p>😕 未找到符合條件的股票</p>
          <a href="/stocks" class="btn btn-secondary">清除篩選</a>
        </div>
      <% } %>

      <% displayStocks.forEach(stock => { %>
        <a href="/stocks/<%= stock.symbol %>" class="stock-card">
          <div class="stock-card-header">
            <div class="stock-identity">
              <span class="stock-market-badge <%= stock.market.toLowerCase() %>"><%= stock.market %></span>
              <span class="stock-symbol"><%= stock.symbol %></span>
            </div>
            <span class="rec-badge rec-<%= stock.recommendation.replace(/\s/g,'') %>">
              <%= stock.recommendation %>
            </span>
          </div>
          <div class="stock-name"><%= stock.name %></div>
          <div class="stock-sector"><%= stock.sector %></div>
          <div class="stock-price-row">
            <span class="stock-price"><%= stock.currency === 'HKD' ? 'HK$' : '¥' %><%= stock.currentPrice.toFixed(2) %></span>
            <span class="stock-change <%= stock.change >= 0 ? 'up' : 'down' %>">
              <%= stock.change >= 0 ? '▲' : '▼' %>
              <%= Math.abs(stock.changePercent).toFixed(2) %>%
            </span>
          </div>
          <div class="stock-success-rate">
            <span class="rate-label">預測成功率</span>
            <div class="rate-bar">
              <div class="rate-fill" style="width: <%= stock.successRate %>%"></div>
            </div>
            <span class="rate-value"><%= stock.successRate %>%</span>
          </div>
          <div class="stock-card-footer">
            <span>點擊查看詳細分析 →</span>
          </div>
        </a>
      <% }); %>
    </div>

    <!-- 免責聲明 (Disclaimer) -->
    <div class="disclaimer">
      <p>⚠️ <strong>免責聲明：</strong>本平台提供之股票預測分析僅供參考，不構成任何投資建議。股票市場存在風險，投資者應自行判斷並承擔投資風險。過往業績不代表未來表現。</p>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 股票預測中心. 版權所有. | 數據僅供參考，請自行核實</p>
    </div>
  </footer>
</body>
</html>
