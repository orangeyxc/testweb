<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>訂單記錄</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <nav class="navbar">
      <div class="container">
        <h1 class="logo">資源商店 🛒</h1>
        <ul class="nav-menu">
          <li><a href="/">首頁</a></li>
          <li><a href="/cart">購物車</a></li>
          <li><a href="/orders" class="active">訂單記錄</a></li>
          <li><a href="/payment">支付設定</a></li>
          <li><a href="/logout">登出 (<%= user.username %>)</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <main class="container">
    <h2>我嘅訂單</h2>
    
    <% if (orders.length === 0) { %>
      <div class="empty-orders">
        <p>您未有任何訂單</p>
        <a href="/" class="btn btn-primary">開始購物</a>
      </div>
    <% } else { %>
      <div class="orders-container">
        <% orders.forEach(order => { %>
          <div class="order-card">
            <div class="order-header">
              <h3>訂單 #<%= order.id %></h3>
              <span class="order-status <%= order.status %>">
                <%= order.status === 'pending' ? '處理中' : '已完成' %>
              </span>
            </div>
            <div class="order-body">
              <p><strong>訂單日期:</strong> <%= new Date(order.created_at).toLocaleString('zh-HK') %></p>
              <p><strong>產品:</strong> <%= order.products %></p>
              <p><strong>總金額:</strong> HK$ <%= order.total_amount.toFixed(2) %></p>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </main>

  <footer>
    <div class="container">
      <p>&copy; 2026 資源商店. 版權所有.</p>
    </div>
  </footer>
</body>
</html>
